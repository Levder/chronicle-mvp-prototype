# API
APP_NAME=Verified Local Chronicle MVP
DEBUG=true
DATABASE_URL=sqlite+aiosqlite:///./data/chronicle.db

# LLM (optional for claim extraction)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# API request mode: chat_completions (default) or agents (existing Agents API session)
OPENAI_API_MODE=chat_completions
OPENAI_AGENT_SESSION_ID=
# If OPENAI_API_KEY is empty, demo uses heuristic extraction.
# For Agents API, OPENAI_API_KEY needs Agents session and Responses API permissions.
# The restricted executor key is separate: provide it to codex exec-server as CODEX_API_KEY.
# Do not put the executor key in this app's .env.

# Solana (devnet for prototype)
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet
# Base58 secret key of service wallet (DO NOT commit real key)
SOLANA_PRIVATE_KEY=
SOLANA_ENABLED=false
# Set true only when key + RPC are configured

# City beachhead
DEFAULT_CITY=irpin
